# Puerto del servidor
PORT=3001

# URL del frontend permitida por CORS (desarrollo)
FRONTEND_URL=http://localhost:5173

# Clave de OpenAI para Whisper. Opcional: solo se usa cuando el navegador no
# trae reconocimiento de voz propio (Firefox). Sin ella, la voz por Whisper
# responde 503 y el resto de la aplicación funciona igual. No subir al repositorio.
OPENAI_API_KEY=
